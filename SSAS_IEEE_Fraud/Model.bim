        "measures": [
          {
            "name": "Montant Total Transactions",
            "expression": " SUM(Fact_Transactions[TransactionAmt])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ Anglais (États-Unis)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Nombre Transactions",
            "expression": " COUNT(Fact_Transactions[TransactionID])",
            "formatString": "0"
          },
          {
            "name": "Nombre Fraudes",
            "expression": " CALCULATE([Nombre Transactions], Fact_Transactions[isFraud] = 1)"
          },
          {
            "name": "Taux Fraude",
            "expression": " DIVIDE([Nombre Fraudes], [Nombre Transactions], 0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Panier Moyen",
            "expression": " AVERAGE(Fact_Transactions[TransactionAmt])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ Anglais (États-Unis)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
