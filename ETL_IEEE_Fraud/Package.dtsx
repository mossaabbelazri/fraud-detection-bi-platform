      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F057296-F11B-4FDF-97B2-C58BCF55A966}"
          SQLTask:SqlStatementSource="-- 1. Vider la table de faits (TRUNCATE fonctionne ici car elle n'est référencée par personne)&#xA;TRUNCATE TABLE Fact_Transactions;&#xA;&#xA;-- 2. Vider les dimensions avec DELETE pour respecter les clés étrangères&#xA;DELETE FROM Dim_Cards;&#xA;DELETE FROM Dim_Devices;&#xA;DELETE FROM Dim_Locations;&#xA;&#xA;-- 3. Remettre les clés primaires (Identity) à zéro pour que les ID recommencent à 1&#xA;DBCC CHECKIDENT ('Dim_Cards', RESEED, 0);&#xA;DBCC CHECKIDENT ('Dim_Devices', RESEED, 0);&#xA;DBCC CHECKIDENT ('Dim_Locations', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
